set $mod Mod4
set $term kitty

# Font 
font pango:JetBrainsMono Regular 8

# Start XDG autostart
exec --no-startup-id dex --autostart --environment sway

exec dbus-update-activation-environment --systemd WAYLAND_DISPLAY XDG_CURRENT_DESKTOP
# wallpaper
output * bg ~/.config/sway/wallpapers.webp fill
# Layout
input * {
    xkb_layout "us,ru"
    xkb_options "grp:alt_shift_toggle"
}

# Gaps
gaps inner 8
gaps outer 1

# shadows
shadows enable
shadow_blur_radius 20
shadow_color #000000F1

# Rounded corners
corner_radius 10

# Title
for_window [class="^.*"] border pixel 2
client.focused #ffffff #ffffff #000000 #ffffff #ffffff
client.unfocused #000000 #000000 #ffffff #000000 #000000

# Lockscreen and idle
exec swayidle -w \
	timeout 1800 'swaylock -f' \
	timeout 1805 'swaymsg "output * power off"' \
		resume 'swaymsg "output * power on"'
bindsym --to-code $mod+l exec swaylock -f

# Screenshot
bindsym Print exec hyprshot -m region

# Notifications
exec_always --no-startup-id mako

# Clipboard
exec wl-paste --watch cliphist store
bindsym --to-code $mod+c exec rofi -modi clipboard:~/.config/cliphist-rofi -show clipboard

# NetworkManager applet
exec --no-startup-id nm-applet &

# Volume control
set $refresh_i3status killall -SIGUSR1 i3status
bindsym XF86AudioRaiseVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ +6% && $refresh_i3status
bindsym XF86AudioLowerVolume exec --no-startup-id pactl set-sink-volume @DEFAULT_SINK@ -6% && $refresh_i3status
bindsym XF86AudioMute exec --no-startup-id pactl set-sink-mute @DEFAULT_SINK@ toggle && $refresh_i3status
bindsym XF86AudioMicMute exec --no-startup-id pactl set-source-mute @DEFAULT_SOURCE@ toggle && $refresh_i3status

bindsym $mod+o exec kitty -e wiremix

# Brightness control
bindsym XF86MonBrightnessUp exec --no-startup-id brightnessctl set +5%
bindsym XF86MonBrightnessDown exec --no-startup-id brightnessctl set 5%-

# Use Mouse+$mod to drag floating windows to their wanted position
floating_modifier $mod

seat seat0 xcursor_theme GoogleDot-Black

# touchpad
input type:touchpad {
    tap enabled
    natural_scroll enabled
}
bindgesture swipe:right workspace prev
bindgesture swipe:left workspace next
bindgesture swipe:down kill
bindgesture swipe:up exec $term
bindgesture hold:3 exec rofi -show drun

# start a terminal
bindsym $mod+Return exec $term

# kill focused window
bindsym --to-code $mod+q kill

# start file manager
bindsym --to-code $mod+e exec thunar

# start firefox
bindsym --to-code $mod+x exec firefox

# start wofi -show drun (a program launcher)
bindsym --to-code $mod+d exec --no-startup-id rofi -show drun
# rofi -show window (switching windows)
bindsym $mod+Tab exec rofi -show window

# change focus
bindsym $mod+j focus left
bindsym $mod+k focus down
bindsym $mod+l focus up
bindsym $mod+semicolon focus right

# alternatively, you can use the cursor keys:
bindsym $mod+Left focus left
bindsym $mod+Down focus down
bindsym $mod+Up focus up
bindsym $mod+Right focus right

# move focused window
bindsym $mod+Shift+j move left
bindsym $mod+Shift+k move down
bindsym $mod+Shift+l move up
bindsym $mod+Shift+semicolon move right

# alternatively, you can use the cursor keys:
bindsym $mod+Shift+Left move left
bindsym $mod+Shift+Down move down
bindsym $mod+Shift+Up move up
bindsym $mod+Shift+Right move right

# split in horizontal orientation
bindsym --to-code $mod+h split h

# split in vertical orientation
bindsym --to-code $mod+v split v

# enter fullscreen mode for the focused container
bindsym --to-code $mod+f fullscreen toggle

# change container layout (stacked, tabbed, toggle split)
bindsym --to-code $mod+s layout stacking
bindsym --to-code $mod+w layout tabbed
bindsym --to-code $mod+z layout toggle split

# toggle tiling / floating
bindsym $mod+Shift+space floating toggle

# change focus between tiling / floating windows
bindsym $mod+space focus mode_toggle

# focus the parent container
bindsym --to-code $mod+a focus parent

# focus the child container
#bindsym $mod+d focus child

# Workspaces
set $ws1 "1"
set $ws2 "2"
set $ws3 "3"
set $ws4 "4"
set $ws5 "5"
set $ws6 "6"
set $ws7 "7"
set $ws8 "8"
set $ws9 "9"
set $ws10 "10"

# switch to workspace
bindsym $mod+1 workspace number $ws1
bindsym $mod+2 workspace number $ws2
bindsym $mod+3 workspace number $ws3
bindsym $mod+4 workspace number $ws4
bindsym $mod+5 workspace number $ws5
bindsym $mod+6 workspace number $ws6
bindsym $mod+7 workspace number $ws7
bindsym $mod+8 workspace number $ws8
bindsym $mod+9 workspace number $ws9
bindsym $mod+0 workspace number $ws10

# move focused container to workspace
bindsym $mod+Shift+1 move container to workspace number $ws1
bindsym $mod+Shift+2 move container to workspace number $ws2
bindsym $mod+Shift+3 move container to workspace number $ws3
bindsym $mod+Shift+4 move container to workspace number $ws4
bindsym $mod+Shift+5 move container to workspace number $ws5
bindsym $mod+Shift+6 move container to workspace number $ws6
bindsym $mod+Shift+7 move container to workspace number $ws7
bindsym $mod+Shift+8 move container to workspace number $ws8
bindsym $mod+Shift+9 move container to workspace number $ws9
bindsym $mod+Shift+0 move container to workspace number $ws10

# reload the configuration file
bindsym --to-code $mod+Shift+c reload
# restart sway
bindsym $mod+Shift+r restart
# wlogout (logout, poweroff, reboot)
bindsym --to-code $mod+p exec ~/.config/rofi/powermenu.sh

# waybar
exec waybar -c ~/.config/waybar/config1.jsonc

# greeting
exec notify-send "Hello!"

# window rules
for_window [app_id="mate-calc"] floating toggle

# fastfetch
bindsym --to-code alt+f exec kitty --hold fastfetch 
